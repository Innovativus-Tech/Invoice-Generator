generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.Text
  slug      String   @unique @db.Text
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  members        OrganizationMember[]
  invitations    OrganizationInvitation[]
  profiles       Profile[]
  clients        Client[]
  invoices       Invoice[]
  invoiceItems   InvoiceItem[]
  inventoryItems InventoryItem[]
  notifications  Notification[]
  purchaseOrders PurchaseOrder[]
  orgBooks       OrgBook[]
  orgClients     OrgClient[]
  numberSeries   NumberSeries[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@map("organizations")
}

model OrganizationMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @db.Text
  invitedBy String?  @map("invited_by") @db.Uuid
  status    String   @default("active") @db.Text
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  email     String   @db.Text
  role      String   @db.Text
  invitedBy String   @map("invited_by") @db.Uuid
  token     String   @unique @default(dbgenerated("encode(gen_random_bytes(32), 'hex')")) @db.Text
  status    String?  @default("pending") @db.Text
  expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '7 days'")) @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("organization_invitations")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFILES  (id = auth.users.id)
// ─────────────────────────────────────────────────────────────────────────────

model Profile {
  id                String   @id @db.Uuid
  businessName      String?  @map("business_name") @db.Text
  businessEmail     String?  @map("business_email") @db.Text
  businessAddress   String?  @map("business_address") @db.Text
  businessPhone     String?  @map("business_phone") @db.Text
  logoUrl           String?  @map("logo_url") @db.Text
  currency          String?  @default("USD") @db.Text
  paymentTerms      String?  @default("Net 30") @map("payment_terms") @db.Text
  invoicePrefix     String?  @default("INV") @map("invoice_prefix") @db.Text
  nextInvoiceNumber Int?     @default(1001) @map("next_invoice_number")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  signatoryName     String?  @map("signatory_name") @db.Text
  signatureUrl      String?  @map("signature_url") @db.Text
  gstin             String?  @db.Text
  website           String?  @db.Text
  bankName          String?  @map("bank_name") @db.Text
  bankAccountNumber String?  @map("bank_account_number") @db.Text
  bankIfsc          String?  @map("bank_ifsc") @db.Text
  bankBranch        String?  @map("bank_branch") @db.Text
  orgId             String?  @map("org_id") @db.Uuid
  showBookMetadata  Boolean  @default(false) @map("show_book_metadata")

  organization Organization? @relation(fields: [orgId], references: [id])

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTACTS  (global contact book, not org-scoped)
// ─────────────────────────────────────────────────────────────────────────────

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.Text
  email     String?  @db.Text
  company   String?  @db.Text
  phone     String?  @db.Text
  gstin     String?  @db.Text
  address   String?  @db.Text
  state     String?  @db.Text
  stateCode String?  @map("state_code") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoices   Invoice[]
  orgClients OrgClient[]

  @@map("contacts")
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENTS  (org-scoped clients linked to auth.users)
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String   @db.Text
  email           String?  @db.Text
  company         String?  @db.Text
  address         String?  @db.Text
  phone           String?  @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  gstin           String?  @db.Text
  state           String?  @db.Text
  stateCode       String?  @map("state_code") @db.Text
  orgId           String?  @map("org_id") @db.Uuid
  // Party fields (migration 020)
  partyType       String   @default("customer") @map("party_type") @db.Text
  creditDays      Int      @default(0) @map("credit_days")
  creditLimit     Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  openingBalance  Decimal  @default(0) @map("opening_balance") @db.Decimal(12, 2)
  pincode         String?  @db.Text
  shippingAddress String?  @map("shipping_address") @db.Text
  shippingState   String?  @map("shipping_state") @db.Text
  shippingPincode String?  @map("shipping_pincode") @db.Text

  organization   Organization?   @relation(fields: [orgId], references: [id])
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  payments       Payment[]

  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  invoiceNumber  String    @map("invoice_number") @db.Text
  status         String    @default("draft") @db.Text
  issueDate      DateTime  @map("issue_date") @db.Date
  subtotal       Decimal   @default(0) @db.Decimal(12, 2)
  taxRate        Decimal?  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal?  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal?  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  total          Decimal   @default(0) @db.Decimal(12, 2)
  currency       String?   @default("USD") @db.Text
  notes          String?   @db.Text
  terms          String?   @db.Text
  pdfUrl         String?   @map("pdf_url") @db.Text
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  viewedAt       DateTime? @map("viewed_at") @db.Timestamptz(6)
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplyType     String?   @default("IGST") @map("supply_type") @db.Text
  billNumber     String?   @map("bill_number") @db.Text
  placeOfSupply  String?   @map("place_of_supply") @db.Text
  orderId        String?   @map("order_id") @db.Text
  orderDate      DateTime? @map("order_date") @db.Date
  orgId          String?   @map("org_id") @db.Uuid

  // Voucher fields (migration 020) — every trading document lives in this table
  docType              String    @default("sales_invoice") @map("doc_type") @db.Text
  paymentMode          String    @default("credit") @map("payment_mode") @db.Text
  partyName            String?   @map("party_name") @db.Text
  partyPhone           String?   @map("party_phone") @db.Text
  creditDays           Int       @default(0) @map("credit_days")
  dueDate              DateTime? @map("due_date") @db.Date
  billingAddress       String?   @map("billing_address") @db.Text
  shippingName         String?   @map("shipping_name") @db.Text
  shippingAddress      String?   @map("shipping_address") @db.Text
  extraDiscountType    String    @default("percent") @map("extra_discount_type") @db.Text
  extraDiscountValue   Decimal   @default(0) @map("extra_discount_value") @db.Decimal(12, 2)
  postageCharge        Decimal   @default(0) @map("postage_charge") @db.Decimal(12, 2)
  otherCharges         Decimal   @default(0) @map("other_charges") @db.Decimal(12, 2)
  otherChargesLabel    String?   @map("other_charges_label") @db.Text
  applyRoundOff        Boolean   @default(false) @map("apply_round_off")
  roundOff             Decimal   @default(0) @map("round_off") @db.Decimal(12, 2)
  amountPaid           Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  sourceDocId          String?   @map("source_doc_id") @db.Uuid
  partyRefNumber       String?   @map("party_ref_number") @db.Text
  partyRefDate         DateTime? @map("party_ref_date") @db.Date
  affectsStock         Boolean   @default(true) @map("affects_stock")
  validUntil           DateTime? @map("valid_until") @db.Date
  reason               String?   @db.Text
  approvalStatus       String?   @map("approval_status") @db.Text
  approvedBy           String?   @map("approved_by") @db.Uuid
  approvedAt           DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectionReason      String?   @map("rejection_reason") @db.Text
  dispatchMode         String    @default("none") @map("dispatch_mode") @db.Text
  deliveryStatus       String    @default("pending") @map("delivery_status") @db.Text
  courierName          String?   @map("courier_name") @db.Text
  trackingNumber       String?   @map("tracking_number") @db.Text
  dispatchDate         DateTime? @map("dispatch_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  deliveredDate        DateTime? @map("delivered_date") @db.Date
  transportName        String?   @map("transport_name") @db.Text
  lrNumber             String?   @map("lr_number") @db.Text
  vehicleNumber        String?   @map("vehicle_number") @db.Text
  cartons              Int?
  freightType          String?   @map("freight_type") @db.Text
  deliveryType         String?   @map("delivery_type") @db.Text
  transportDetails     String?   @map("transport_details") @db.Text

  organization   Organization?   @relation(fields: [orgId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  sourceDoc      Invoice?        @relation("DocConversion", fields: [sourceDocId], references: [id], onDelete: SetNull)
  derivedDocs    Invoice[]       @relation("DocConversion")
  invoiceItems   InvoiceItem[]
  notifications  Notification[]
  payments       Payment[]
  stockMovements StockMovement[]

  @@map("invoices")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVOICE ITEMS
// ─────────────────────────────────────────────────────────────────────────────

model InvoiceItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  description     String   @db.Text
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder       Int?     @default(0) @map("sort_order")
  hsnSac          String?  @default("") @map("hsn_sac") @db.Text
  gstRate         Decimal? @default(18) @map("gst_rate") @db.Decimal(5, 2)
  discountPercent Decimal? @default(0) @map("discount_percent") @db.Decimal(5, 2)
  isbn            String?  @db.Text
  author          String?  @db.Text
  orgId           String?  @map("org_id") @db.Uuid
  itemId          String?  @map("item_id") @db.Uuid
  binding         String?  @db.Text
  damagedQty      Decimal  @default(0) @map("damaged_qty") @db.Decimal(10, 2)

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [orgId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// BOOKS  (global book catalog — quoted column names)
// ─────────────────────────────────────────────────────────────────────────────

model Book {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookTitle       String                   @map("Book Title") @db.Text
  isbn            String?                  @map("ISBN") @db.Text
  productForm     String?                  @map("Product Form") @db.Text
  language        String?                  @map("Language") @db.Text
  applicantType   String?                  @map("Applicant Type") @db.Text
  publisher       String?                  @map("Name of Publishing Agency/Publisher") @db.Text
  imprint         String?                  @map("Imprint") @db.Text
  author          String?                  @map("Name of Author/Editor") @db.Text
  publicationDate String?                  @map("Publication Date") @db.Text
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  searchVector    Unsupported("tsvector")? @map("search_vector")

  orgBooks OrgBook[]

  @@map("books")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY ITEMS  (org-scoped book catalog with pricing & stock)
// Note: the DB also has a `"#"` integer column — omitted as it is unaddressable
// ─────────────────────────────────────────────────────────────────────────────

model InventoryItem {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?                  @map("user_id") @db.Uuid
  bookTitle       String                   @map("Book Title") @db.Text
  isbn            String?                  @map("ISBN") @db.Text
  productForm     String?                  @map("Product Form") @db.Text
  language        String?                  @map("Language") @db.Text
  applicantType   String?                  @map("Applicant Type") @db.Text
  publisher       String?                  @map("Name of Publishing Agency/Publisher") @db.Text
  imprint         String?                  @map("Imprint") @db.Text
  author          String?                  @map("Name of Author/Editor") @db.Text
  publicationDate String?                  @map("Publication Date") @db.Text
  price           Decimal?                 @default(0) @db.Decimal(12, 2)
  gstRate         Decimal?                 @default(0) @map("gst_rate") @db.Decimal(5, 2)
  stock           Int?                     @default(1)
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  orgId           String?                  @map("org_id") @db.Uuid
  binding         String?                  @db.Text
  purchaseRate    Decimal                  @default(0) @map("purchase_rate") @db.Decimal(12, 2)
  minStock        Int                      @default(0) @map("min_stock")
  damagedStock    Int                      @default(0) @map("damaged_stock")
  hsnCode         String?                  @map("hsn_code") @db.Text

  organization   Organization?   @relation(fields: [orgId], references: [id])
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  @@map("inventory_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORG BOOKS  (org's curated list from the global books catalog)
// ─────────────────────────────────────────────────────────────────────────────

model OrgBook {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  price     Decimal? @default(0) @db.Decimal(12, 2)
  gstRate   Decimal? @default(0) @map("gst_rate") @db.Decimal(5, 2)
  stock     Int?     @default(1)
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  book         Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("org_books")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORG CLIENTS  (org's clients linked from the global contacts table)
// ─────────────────────────────────────────────────────────────────────────────

model OrgClient {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  notes     String?  @db.Text
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("org_clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  type      String   @db.Text
  title     String   @db.Text
  message   String   @db.Text
  invoiceId String?  @map("invoice_id") @db.Uuid
  isRead    Boolean? @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [orgId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  invoiceViewed   Boolean? @default(true) @map("invoice_viewed")
  paymentReceived Boolean? @default(true) @map("payment_received")
  invoiceOverdue  Boolean? @default(true) @map("invoice_overdue")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────────────────────────
// PURCHASE ORDERS
// ─────────────────────────────────────────────────────────────────────────────

model PurchaseOrder {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  orgId        String?  @map("org_id") @db.Uuid
  orderId      String   @unique @map("order_id") @db.Text
  clientId     String?  @map("client_id") @db.Uuid
  clientName   String   @map("client_name") @db.Text
  itemName     String   @map("item_name") @db.Text
  quantity     Decimal? @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalAmount  Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  purchaseDate DateTime @map("purchase_date") @db.Date
  notes        String?  @db.Text
  status       String?  @default("completed") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [orgId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("purchase_orders")
}

// ─────────────────────────────────────────────────────────────────────────────
// NUMBER SERIES  (independent numbering per document type)
// ─────────────────────────────────────────────────────────────────────────────

model NumberSeries {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  docType     String   @map("doc_type") @db.Text
  prefix      String   @db.Text
  nextNumber  Int      @default(1) @map("next_number")
  includeYear Boolean  @default(true) @map("include_year")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, docType])
  @@map("number_series")
}

// ─────────────────────────────────────────────────────────────────────────────
// PAYMENTS  (direction "in" = received from party, "out" = paid to party)
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  clientId      String?  @map("client_id") @db.Uuid
  invoiceId     String?  @map("invoice_id") @db.Uuid
  direction     String   @db.Text
  paymentNumber String?  @map("payment_number") @db.Text
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @map("payment_date") @db.Date
  mode          String   @default("cash") @db.Text
  reference     String?  @db.Text
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK MOVEMENTS  (inventory stock = sum of qty_change; damaged = sum of damaged_change)
// ─────────────────────────────────────────────────────────────────────────────

model StockMovement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  docId         String?  @map("doc_id") @db.Uuid
  docType       String   @map("doc_type") @db.Text
  movementDate  DateTime @default(now()) @map("movement_date") @db.Date
  qtyChange     Int      @default(0) @map("qty_change")
  damagedChange Int      @default(0) @map("damaged_change")
  rate          Decimal  @default(0) @db.Decimal(12, 2)
  reason        String?  @db.Text
  userId        String?  @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  doc          Invoice?      @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}
